# --- LOCAL --- 

# Optional overrides for local DynamoDB
LOCAL_DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=eu-west-1
LOCAL_TELEMETRY_TABLE_NAME=example-local-telemetry-table
LOCAL_REJECTED_TELEMETRY_TABLE_NAME=example-local-rejected-telemetry-table

# --- AWS ---

# Required for API Gateway Authorizer when deploying
INGEST_AUTH_TOKEN=replace-with-a-secure-token-3kv0op8
