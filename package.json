{
  "name": "drone-fleet-telemetry-pipeline",
  "version": "1.0.0",
  "description": "An AWS Serverless pipeline for ingesting, validating, transforming, and storing drone fleet telemetry events.",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "process:sample": "tsx src/adapters/local/runners/runLocalTelemetryProcessor.ts samples/telemetry-mixed.ndjson",
    "dynamodb:up": "docker compose up -d dynamodb-local",
    "dynamodb:setup": "tsx src/adapters/local/persistence/local-dynamo-db/setupLocalDynamoDb.ts",
    "process:sample:dynamodb": "tsx src/adapters/local/runners/runLocalTelemetryToDynamoDbProcessor.ts samples/telemetry-mixed.ndjson",
    "dynamodb:down": "docker compose down",
    "test": "jest --config jest.config.cjs --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1061.0",
    "@aws-sdk/client-sqs": "^3.1061.0",
    "@aws-sdk/lib-dynamodb": "^3.1061.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "serverless": "^4.37.0",
    "serverless-esbuild": "^1.57.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
